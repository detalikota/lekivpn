    token = get_marzban_token()
    url = f"{MARZBAN_URL}/api/user/{user_id_str}"
    headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}

    if is_eternal:
        logger.info(f"Setting eternal subscription for user {user_id}")
        data = {
            # some servers prefer 0 instead of JSON null; you can try either
            "expire": None,
            "status": "active"
        }
        response = requests.put(url, headers=headers, json=data)
        response.raise_for_status()

        final_user = get_user_config(user_id_str)
        # check that expire is now either None or zero
        if final_user.get("status") == "active" and final_user.get("expire") in (None, 0):
            cursor.execute(
                "UPDATE payments SET subscription_extended = 1 WHERE payment_id = ?",
                (payment_id,)
            )
            conn.commit()
            conn.close()
            try:
                bot.send_message(user_id_str,
                                 "✅ Оплата прошла успешно! Вам установлена вечная подписка.")
            except Exception:
                pass
            return True
        else:
            logger.error("Failed to confirm eternal subscription on the VPN side")
            cursor.execute(
                "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                ("Eternal subscription not confirmed", payment_id)
            )
            conn.commit()
            conn.close()
            return False

