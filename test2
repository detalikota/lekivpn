def apply_subscription_extension(user_id, payment_id):
    import sqlite3
    conn = sqlite3.connect('/opt/marzban/payments.db')
    cursor = conn.cursor()

    # ─── fetch the amount ─────────────────────────────────────────
    cursor.execute("SELECT amount FROM payments WHERE payment_id = ?", (payment_id,))
    row = cursor.fetchone()
    if not row:
        logger.error(f"No payment record for {payment_id}")
        conn.close()
        return False

    raw_amount = row[0]
    # detect 500₽ or more
    try:
        is_eternal = float(raw_amount) >= 500.0
    except (ValueError, TypeError):
        is_eternal = False

    # ─── get your user config ────────────────────────────────────
    user_id_str = str(user_id)
    current_user = get_user_config(user_id_str)
