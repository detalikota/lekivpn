def apply_subscription_extension(user_id, payment_id):
    """Apply subscription extension with robust error handling."""
    logger.info(f"Applying subscription extension for user {user_id}, payment {payment_id}")
    import sqlite3
    conn = sqlite3.connect('/opt/marzban/payments.db')
    cursor = conn.cursor()
    try:
        # Получаем информацию о платеже для определения типа подписки
        cursor.execute("SELECT amount FROM payments WHERE payment_id = ?", (payment_id,))
        payment_info = cursor.fetchone()
        is_eternal = False
        
        if payment_info and (payment_info[0] == "500.00" or payment_info[0] == "500"):
            is_eternal = True
            logger.info(f"Payment {payment_id} is for eternal subscription")
        
        # Get the user's current status
        user_id_str = str(user_id)
        current_user = get_user_config(user_id_str)
        if "error" in current_user:
            error_msg = f"Failed to get user config: {current_user['error']}"
            logger.error(error_msg)
            cursor.execute(
                "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                (error_msg, payment_id)
            )
            conn.commit()
            conn.close()
            return False
            
        # If user is disabled or expired, first try to activate them
        if current_user.get('status', '') in ['disabled', 'expired']:
            logger.info(f"User {user_id} is {current_user.get('status')}, activating first")
            activation_result = force_activate_user(user_id_str)
            if isinstance(activation_result, dict) and "error" in activation_result:
                error_msg = f"Failed to activate user: {activation_result['error']}"
                logger.error(error_msg)
                cursor.execute(
                    "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                    (error_msg, payment_id)
                )
                conn.commit()
                conn.close()
                return False
                
            # Verify the user is now active
            current_user = get_user_config(user_id_str)
            if current_user.get('status') != 'active':
                error_msg = f"User still not active after activation attempt. Current status: {current_user.get('status')}"
                logger.error(error_msg)
                cursor.execute(
                    "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                    (error_msg, payment_id)
                )
                conn.commit()
                conn.close()
                return False
                
        # Получаем токен для API
        token = get_marzban_token()
        url = f"{MARZBAN_URL}/api/user/{user_id_str}"
        headers = {
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json"
        }
        
        if is_eternal:
            # Для вечной подписки устанавливаем expire = None (или 0)
            data = {
                "expire": None,
                "status": "active"
            }
            logger.info(f"Setting eternal subscription for user {user_id}")
            response = requests.put(url, headers=headers, json=data)
            response.raise_for_status()
            
            # Проверяем, что обновление успешно
            final_user = get_user_config(user_id_str)
            if final_user.get("status") == "active" and (final_user.get("expire") is None or final_user.get("expire") == 0):
                logger.info(f"Successfully set eternal subscription for user {user_id}")
                cursor.execute(
                    "UPDATE payments SET subscription_extended = 1 WHERE payment_id = ?",
                    (payment_id,)
                )
                conn.commit()
                conn.close()
                # Отправляем уведомление пользователю
                try:
                    bot.send_message(
                        str(user_id),
                        "✅ Оплата прошла успешно! Вам установлена вечная подписка."
                    )
                    logger.info(f"Successfully sent eternal subscription notification to user {user_id}")
                except Exception as e:
                    logger.error(f"Error sending notification to user {user_id}: {e}")
                return True
            else:
                error_msg = "Failed to properly set eternal subscription"
                logger.error(error_msg)
                cursor.execute(
                    "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                    (error_msg, payment_id)
                )
                conn.commit()
                conn.close()
                return False
        else:
            # Для обычной подписки используем стандартную логику продления
            # Record current expiry before extension
            current_expiry = current_user.get("expire", 0)
            
            # Now extend the subscription
            logger.info(f"Extending subscription for user {user_id}")
            extend_result = extend_subscription(user_id_str)
        
        if isinstance(extend_result, dict) and "error" in extend_result:
            error_msg = f"Failed to extend subscription: {extend_result['error']}"
            logger.error(error_msg)
            cursor.execute(
                "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                (error_msg, payment_id)
            )
            conn.commit()
            conn.close()
            return False
        
        # Verify the extension worked by checking the new expiry date
        final_user = get_user_config(user_id_str)
        new_expiry = final_user.get("expire", 0)
        
        # If the expiry hasn't changed or is less than current time + 8 days, the extension likely failed
        current_time = int(time.time())
        min_expected_expiry = current_time + (25 * 24 * 3600)  # at least 8 days in the future
        
        if new_expiry <= current_expiry or new_expiry < min_expected_expiry:
            error_msg = f"Subscription may not have been properly extended. Old expiry: {current_expiry}, New expiry: {new_expiry}"
            logger.error(error_msg)
            
            # Try a direct expiry update as a last resort
            logger.info(f"Attempting direct expiry update for user {user_id}")
            token = get_marzban_token()
            url = f"{MARZBAN_URL}/api/user/{user_id_str}"
            headers = {
                "Authorization": f"Bearer {token}",
                "Content-Type": "application/json"
            }
            
            # Set a new expiry 30 days from now
            new_direct_expiry = current_time + (30 * 24 * 3600)
            data = {
                "expire": new_direct_expiry,
                "status": "active"
            }
            
            try:
                direct_response = requests.put(url, headers=headers, json=data)
                direct_response.raise_for_status()
                
                # Verify the direct update worked
                final_check = get_user_config(user_id_str)
                if final_check.get("expire", 0) >= min_expected_expiry:
                    logger.info(f"Direct expiry update successful for user {user_id}")
                    # Mark as successful in database
                    cursor.execute(
                        "UPDATE payments SET subscription_extended = 1 WHERE payment_id = ?",
                        (payment_id,)
                    )
                    conn.commit()
                    conn.close()
                    return True
                else:
                    error_msg += f" Direct update also failed. Final expiry: {final_check.get('expire', 0)}"
                    logger.error(error_msg)
                    cursor.execute(
                        "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                        (error_msg, payment_id)
                    )
                    conn.commit()
                    conn.close()
                    return False
            except Exception as direct_error:
                error_msg += f" Direct update failed with error: {str(direct_error)}"
                logger.error(error_msg)
                cursor.execute(
                    "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                    (error_msg, payment_id)
                )
                conn.commit()
                conn.close()
                return False
        
        # Extension successful
        logger.info(f"Subscription successfully extended for user {user_id}. New expiry: {new_expiry}")
        cursor.execute(
            "UPDATE payments SET subscription_extended = 1 WHERE payment_id = ?",
            (payment_id,)
        )
        conn.commit()
        conn.close()
        return True
        
    except Exception as e:
        error_msg = f"Unexpected error during subscription extension: {str(e)}"
        logger.error(error_msg, exc_info=True)
        try:
            cursor.execute(
                "UPDATE payments SET last_error = ? WHERE payment_id = ?",
                (error_msg, payment_id)
            )
            conn.commit()
        except Exception:
            pass
        finally:
            conn.close()
        return False